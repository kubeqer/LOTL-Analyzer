LOTL_WINDOW_SECONDS=60
LOTL_MAX_BUFFERED_EVENTS_PER_HOST=10000

LOTL_ML_MODEL_PATH=../log_analyzer_ml/data/lotl_xgb.json
LOTL_ML_SIDECAR_PATH=../log_analyzer_ml/data/lotl_xgb.sidecar.json
LOTL_ML_THRESHOLD=0.5

LOTL_YARA_RULES_DIR=./lotl_backend/detectors/yara_rules

LOTL_LLM_BASE_URL=http://localhost:8080/v1
LOTL_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LOTL_LLM_TIMEOUT_SECONDS=30

LOTL_RAG_STORE_DIR=./data/rag_store
LOTL_RAG_COLLECTION=lotl-knowledge
LOTL_RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOTL_RAG_REFRESH_HOURS=24
LOTL_RAG_TOP_K=5
LOTL_RAG_CHUNK_SIZE=900
LOTL_RAG_CHUNK_OVERLAP=150
LOTL_LOLBAS_URL=https://lolbas-project.github.io/api/lolbas.json
LOTL_ADVISORY_FEEDS=https://www.cisa.gov/cybersecurity-advisories/all.xml,https://www.cisa.gov/known-exploited-vulnerabilities-catalog.xml

LOTL_ELASTICSEARCH_URL=http://localhost:9200
LOTL_ELASTICSEARCH_INDEX=lotl-alerts
